{
  "name": "storefront",
  "version": "0.1.0",
  "description": "SPA Storefront Boilerplate for Unchained Engine",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@coingecko/cryptoformat": "0.8.2",
    "@formatjs/intl-datetimeformat": "^8.2.1",
    "@formatjs/intl-numberformat": "^10.1.1",
    "@formatjs/intl-pluralrules": "^7.1.1",
    "@formatjs/intl-relativetimeformat": "^13.0.4",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "@stripe/react-stripe-js": "^7.1.0",
    "@stripe/stripe-js": "^10.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "cookie": "^2.0.2",
    "dotenv-extended": "^3.1.0",
    "graphql": "^16.15.0",
    "http-proxy-middleware": "^4.2.2",
    "intl-messageformat": "^12.2.1",
    "lodash": "^4.18.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-hook-qrcode-svg": "^1.5.1",
    "react-hot-toast": "^2.6.1",
    "react-image-gallery": "^2.1.2",
    "react-intl": "^12.2.1",
    "react-markdown": "^10.1.0",
    "react-range-slider-input": "^3.3.5",
    "rxjs": "^7.8.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.23.0",
    "@graphql-eslint/eslint-plugin": "^5.0.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^8.1.4",
    "eslint-plugin-prettier": "^5.5.7",
    "graphql-config": "^6.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "tar": ">=7.5.11",
    "postcss-selector-parser": "^6.1.5"
  },
  "scripts": {
    "build": "SUPPRESS_ENV_ERRORS=1 next build",
    "dev:local": "UNCHAINED_ENDPOINT=http://localhost:4010/graphql next dev",
    "dev": "next dev",
    "lint": "eslint --fix .",
    "start": "next start",
    "update-schema": "npx --yes get-graphql-schema http://localhost:4010/graphql --json > schema.json && node possibleTypesGenerator.js",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json && node extract-missing-translation-keys.js"
  }
}
