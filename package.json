{
  "name": "storefront",
  "version": "0.1.0",
  "description": "SPA Storefront Boilerplate for Unchained Engine",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@apollo/client": "^4.3.0",
    "@coingecko/cryptoformat": "0.8.2",
    "@formatjs/intl-datetimeformat": "^7.7.0",
    "@formatjs/intl-numberformat": "^9.4.2",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@paypal/react-paypal-js": "^10.4.1",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "canvas-confetti": "^1.9.4",
    "classnames": "^2.5.1",
    "cookie": "^2.0.1",
    "dotenv-extended": "^3.1.0",
    "graphql": "^16.14.2",
    "http-proxy-middleware": "^4.2.0",
    "intl-messageformat": "^11.2.15",
    "lodash": "^4.18.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-hook-qrcode-svg": "^1.5.1",
    "react-hot-toast": "^2.6.0",
    "react-image-gallery": "^2.1.2",
    "react-intl": "^10.2.2",
    "react-markdown": "^10.1.0",
    "react-range-slider-input": "^3.3.5",
    "rxjs": "^7.8.2",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@formatjs/cli": "^6.16.27",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-formatjs": "^6.6.3",
    "eslint-plugin-prettier": "^5.5.6",
    "graphql-config": "^5.1.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tar": ">=7.5.11"
  },
  "scripts": {
    "build": "SUPPRESS_ENV_ERRORS=1 next build",
    "dev:local": "UNCHAINED_ENDPOINT=http://localhost:4010/graphql next dev",
    "dev": "next dev",
    "lint": "eslint --fix .",
    "start": "next start",
    "update-schema": "npx --yes get-graphql-schema http://localhost:4010/graphql --json > schema.json && node possibleTypesGenerator.js",
    "extract-translation": "formatjs extract '(pages|modules)/**/*.{ts,tsx,jsx}' --out-file lang/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "compile-translation": "formatjs compile  ./lang/en.json  --out-file ./i18n/en.json --format custom-formatter.js && node extract-missing-translation-keys.js"
  }
}
